<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - <%= site.appTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 flex items-center justify-center h-screen relative">

  <!-- Login Loading Overlay -->
  <div id="loadingOverlay" class="fixed inset-0 bg-slate-950 bg-opacity-70 z-50 hidden flex-col items-center justify-center text-white backdrop-blur-sm">
    <svg class="animate-spin h-10 w-10 text-blue-500 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-sm font-semibold tracking-wide">Authenticating & Loading Database...</p>
  </div>

  <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-md">
    <h1 class="text-xl font-bold text-gray-800 mb-1 text-center"><%= site.appTitle %></h1>
    <p class="text-xs text-gray-500 text-center mb-6"><%= site.portals.expenses.name %></p>

    <% if (error) { %>
      <div class="bg-red-50 text-red-600 p-3 rounded-lg text-sm mb-4 border border-red-200">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST" id="loginForm" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
        <input type="text" name="username" required 
               class="w-full border border-gray-300 p-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1">Password</label>
        <input type="password" name="password" required 
               class="w-full border border-gray-300 p-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <button type="submit" 
              class="w-full bg-blue-600 text-white py-2.5 rounded-lg font-semibold text-sm hover:bg-blue-700 transition">
        Login to Dashboard
      </button>
    </form>
  </div>

  <script>
    document.getElementById('loginForm').addEventListener('submit', function() {
      const loader = document.getElementById('loadingOverlay');
      loader.classList.remove('hidden');
      loader.classList.add('flex');
    });
  </script>
</body>
</html>