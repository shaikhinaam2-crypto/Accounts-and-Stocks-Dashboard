<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= site.appTitle %> - <%= site.portals.ledger.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans flex h-screen relative">

  <!-- Global Database Loading Overlay -->
  <div id="loadingOverlay" class="fixed inset-0 bg-slate-900 bg-opacity-50 z-50 hidden flex-col items-center justify-center text-white backdrop-blur-sm">
    <svg class="animate-spin h-10 w-10 text-purple-500 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-sm font-semibold tracking-wide">Processing Ledger Transaction...</p>
  </div>

  <!-- Left Sidebar -->
  <aside class="w-64 bg-slate-900 text-white flex flex-col justify-between shrink-0 no-print">
    <div>
      <div class="p-6 text-lg font-bold border-b border-slate-800 leading-snug"><%= site.appTitle %></div>
      <nav class="mt-4">
        <div class="px-6 py-2 text-xs text-slate-400 uppercase tracking-wider">Portals</div>
        <a href="<%= site.portals.expenses.path %>" onclick="showLoader()" class="flex items-center px-6 py-3 text-slate-300 hover:bg-slate-800 text-sm">
          <%= site.portals.expenses.name %>
        </a>
        <a href="<%= site.portals.ledger.path %>" onclick="showLoader()" class="flex items-center px-6 py-3 bg-purple-600 text-white font-medium text-sm">
          <%= site.portals.ledger.name %>
        </a>
        <a href="<%= site.portals.menuThree.path %>" class="flex items-center px-6 py-3 text-slate-300 hover:bg-slate-800 text-sm">
          <%= site.portals.menuThree.name %>
        </a>
      </nav>
    </div>
    <div class="p-4 border-t border-slate-800">
      <a href="/settings" onclick="showLoader()" class="block py-2 text-sm text-slate-300 hover:text-white">Settings</a>
      <a href="/logout" onclick="showLoader()" class="block py-2 text-sm text-red-400 hover:text-red-300">Logout</a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 overflow-y-auto p-8">
    <div class="flex justify-between items-center mb-4">
      <h1 class="text-2xl font-bold text-gray-800"><%= site.portals.ledger.name %></h1>
    </div>

    <!-- Sub-page Navigation -->
    <div class="flex border-b border-gray-200 mb-6">
      <a href="/ledger" onclick="showLoader()" class="py-2 px-4 font-semibold text-sm border-b-2 border-purple-600 text-purple-600">
        <%= site.subMenus.ledgerOverview %>
      </a>
      <a href="/ledger/entries" onclick="showLoader()" class="py-2 px-4 font-semibold text-sm text-gray-500 hover:text-gray-700">
        <%= site.subMenus.manageLedger %>
      </a>
    </div>

    <!-- Forms Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      
      <!-- 1. Create Ledger Account -->
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
        <h2 class="text-base font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100">1. Create Credit / Debit Account</h2>
        <form action="/ledger/accounts/create" method="POST" class="flex gap-3 db-form">
          <input type="text" name="name" placeholder="e.g. Pickle Masala from Ahmed" required
                 class="flex-1 border border-gray-300 p-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
          <button type="submit" class="bg-slate-800 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-slate-700 transition">
            Add Account
          </button>
        </form>
      </div>

      <!-- 2. Record Transaction -->
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
        <h2 class="text-base font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100">2. Record Transaction</h2>
        <form action="/ledger/entries/create" method="POST" class="space-y-3 db-form">
          <div>
            <select name="account_id" required class="w-full border border-gray-300 p-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
              <option value="">Select Account</option>
              <% accounts.forEach(acc => { %>
                <option value="<%= acc.id %>"><%= acc.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-gray-500 mb-1">Transaction Type</label>
              <select name="type" required class="w-full border border-gray-300 p-2.5 rounded-lg text-sm font-bold focus:outline-none focus:ring-2 focus:ring-purple-500">
                <option value="CREDIT" class="text-red-600">CREDIT (+) Goods Pickup / Debt Taken</option>
                <option value="DEBIT" class="text-emerald-600">DEBIT (-) Payment Made to Vendor</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 mb-1">Amount (PKR)</label>
              <input type="number" step="0.01" name="amount" placeholder="e.g. 7000" required 
                     class="w-full border border-gray-300 p-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-gray-500 mb-1">Date</label>
              <input type="date" name="date" value="<%= defaultDate %>" required 
                     class="w-full border border-gray-300 p-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 mb-1">Notes / Item Details</label>
              <input type="text" name="notes" placeholder="e.g. Picked 50kg Masala" 
                     class="w-full border border-gray-300 p-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
            </div>
          </div>

          <button type="submit" class="w-full bg-purple-600 text-white py-2.5 rounded-lg font-semibold text-sm hover:bg-purple-700 transition">
            Save Entry
          </button>
        </form>
      </div>

    </div>

    <!-- Account Outstanding Balances Summary Cards -->
    <h2 class="text-lg font-bold text-gray-800 mb-4">Current Outstanding Balances</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <% accountBalances.forEach(acc => { %>
        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Account</span>
            <h3 class="font-bold text-gray-800 text-base mb-2"><%= acc.name %></h3>
            <div class="text-xs text-gray-500 space-y-1">
              <p>Total Items Received (Credit): <span class="font-bold text-red-600"><%= acc.totalCredit.toLocaleString() %> PKR</span></p>
              <p>Total Paid Back (Debit): <span class="font-bold text-emerald-600"><%= acc.totalDebit.toLocaleString() %> PKR</span></p>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-100 flex justify-between items-center">
            <span class="text-xs font-semibold text-gray-600">Net Payable:</span>
            <span class="text-lg font-extrabold <%= acc.balance > 0 ? 'text-red-600' : 'text-emerald-600' %>">
              <%= acc.balance.toLocaleString() %> PKR
            </span>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Transaction History Table -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="p-4 border-b border-gray-200 bg-gray-50">
        <h2 class="font-bold text-gray-700">Ledger History Log</h2>
      </div>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b bg-gray-100 text-xs font-semibold text-gray-600 uppercase">
            <th class="p-3.5 border-r">Date</th>
            <th class="p-3.5 border-r">Account Name</th>
            <th class="p-3.5 border-r">Type</th>
            <th class="p-3.5 border-r">Notes / Details</th>
            <th class="p-3.5 text-right">Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y text-sm text-gray-700">
          <% if (entries.length === 0) { %>
            <tr>
              <td colspan="5" class="p-6 text-center text-gray-400">No ledger transactions recorded yet.</td>
            </tr>
          <% } else { %>
            <% entries.forEach(entry => { %>
              <tr class="hover:bg-gray-50">
                <td class="p-3.5 border-r text-gray-500"><%= entry.date %></td>
                <td class="p-3.5 border-r font-semibold text-gray-800"><%= entry.account_name %></td>
                <td class="p-3.5 border-r">
                  <span class="px-2.5 py-1 rounded text-xs font-bold <%= entry.type === 'CREDIT' ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700' %>">
                    <%= entry.type === 'CREDIT' ? 'CREDIT (+Debt)' : 'DEBIT (-Paid)' %>
                  </span>
                </td>
                <td class="p-3.5 border-r text-gray-600"><%= entry.notes || '-' %></td>
                <td class="p-3.5 text-right font-bold <%= entry.type === 'CREDIT' ? 'text-red-600' : 'text-emerald-600' %>">
                  <%= parseFloat(entry.amount).toLocaleString() %> PKR
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    function showLoader() {
      document.getElementById('loadingOverlay').classList.remove('hidden');
      document.getElementById('loadingOverlay').classList.add('flex');
    }

    document.querySelectorAll('.db-form').forEach(form => {
      form.addEventListener('submit', function() {
        showLoader();
      });
    });
  </script>

</body>
</html>