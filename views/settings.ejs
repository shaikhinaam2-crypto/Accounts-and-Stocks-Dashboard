<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - Personal Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans flex h-screen">

  <!-- Main Left Sidebar Navigation -->
<aside class="w-64 bg-slate-900 text-white flex flex-col justify-between shrink-0 no-print">
  <div>
    <div class="p-6 text-lg font-bold border-b border-slate-800 leading-snug"><%= site.appTitle %></div>
    <nav class="mt-4">
      <div class="px-6 py-2 text-xs text-slate-400 uppercase tracking-wider">Portals</div>
      
      <!-- Portal 1 -->
      <a href="<%= site.portals.expenses.path %>" onclick="showLoader()" class="flex items-center px-6 py-3 bg-blue-600 text-white font-medium text-sm">
        <%= site.portals.expenses.name %>
      </a>

      <!-- Portal 2 (Credit & Debit Ledger) -->
      <a href="<%= site.portals.ledger.path %>" onclick="showLoader()" class="flex items-center px-6 py-3 text-slate-300 hover:bg-slate-800 text-sm">
        <%= site.portals.ledger.name %>
      </a>

      <!-- Portal 3 -->
      <a href="<%= site.portals.menuThree.path %>" class="flex items-center px-6 py-3 text-slate-300 hover:bg-slate-800 text-sm">
        <%= site.portals.menuThree.name %>
      </a>
    </nav>
  </div>
  <div class="p-4 border-t border-slate-800">
    <a href="/settings" onclick="showLoader()" class="block py-2 text-sm text-slate-300 hover:text-white">Settings</a>
    <a href="/logout" onclick="showLoader()" class="block py-2 text-sm text-red-400 hover:text-red-300">Logout</a>
  </div>
</aside>

  <!-- Main View Area -->
  <main class="flex-1 p-8 overflow-y-auto">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Account Settings</h1>

    <div class="max-w-md bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Change Password</h2>

      <% if (message) { %>
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm p-3 rounded-lg mb-4">
          <%= message %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="bg-red-50 border border-red-200 text-red-600 text-sm p-3 rounded-lg mb-4">
          <%= error %>
        </div>
      <% } %>

      <form action="/settings/change-password" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
          <input type="password" name="currentPassword" required class="w-full border border-gray-300 p-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
          <input type="password" name="newPassword" required class="w-full border border-gray-300 p-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <button type="submit" class="w-full bg-slate-800 text-white py-2 rounded font-semibold hover:bg-slate-700 transition">
          Update Password
        </button>
      </form>
    </div>
  </main>

</body>
</html>