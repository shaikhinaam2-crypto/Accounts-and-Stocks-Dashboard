<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= site.appTitle %> - <%= site.portals.expenses.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  
  <style>
    @media print {
      aside, .no-print, form, #loadingOverlay {
        display: none !important;
      }
      main {
        padding: 0 !important;
        overflow: visible !important;
      }
      .printable-area {
        border: none !important;
        box-shadow: none !important;
      }
    }
  </style>
</head>
<body class="bg-gray-100 font-sans flex h-screen relative">

  <!-- Global Database Loading Overlay -->
  <div id="loadingOverlay" class="fixed inset-0 bg-slate-900 bg-opacity-50 z-50 hidden flex-col items-center justify-center text-white backdrop-blur-sm">
    <svg class="animate-spin h-10 w-10 text-blue-500 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-sm font-semibold tracking-wide">Processing Database Operation...</p>
  </div>

  <!-- Main Left Sidebar Navigation -->
<aside class="w-64 bg-slate-900 text-white flex flex-col justify-between shrink-0 no-print">
  <div>
    <div class="p-6 text-lg font-bold border-b border-slate-800 leading-snug"><%= site.appTitle %></div>
    <nav class="mt-4">
      <div class="px-6 py-2 text-xs text-slate-400 uppercase tracking-wider">Portals</div>
      
      <!-- Portal 1 -->
      <a href="<%= site.portals.expenses.path %>" onclick="showLoader()" class="flex items-center px-6 py-3 bg-blue-600 text-white font-medium text-sm">
        <%= site.portals.expenses.name %>
      </a>

      <!-- Portal 2 (Credit & Debit Ledger) -->
      <a href="<%= site.portals.ledger.path %>" onclick="showLoader()" class="flex items-center px-6 py-3 text-slate-300 hover:bg-slate-800 text-sm">
        <%= site.portals.ledger.name %>
      </a>

      <!-- Portal 3 -->
      <a href="<%= site.portals.menuThree.path %>" class="flex items-center px-6 py-3 text-slate-300 hover:bg-slate-800 text-sm">
        <%= site.portals.menuThree.name %>
      </a>
    </nav>
  </div>
  <div class="p-4 border-t border-slate-800">
    <a href="/settings" onclick="showLoader()" class="block py-2 text-sm text-slate-300 hover:text-white">Settings</a>
    <a href="/logout" onclick="showLoader()" class="block py-2 text-sm text-red-400 hover:text-red-300">Logout</a>
  </div>
</aside>

  <!-- Main View Area -->
  <main class="flex-1 overflow-y-auto p-8">
    <div class="flex justify-between items-center mb-4 no-print">
      <h1 class="text-2xl font-bold text-gray-800"><%= site.portals.expenses.name %></h1>
      <div class="text-sm bg-blue-50 text-blue-800 border border-blue-200 px-4 py-2 rounded-lg font-semibold">
        Grand Total: <%= grandTotal.toLocaleString() %> PKR
      </div>
    </div>

    <!-- Dynamic Sub-page Tab Navigation -->
    <div class="flex border-b border-gray-200 mb-6 no-print">
      <a href="/dashboard" onclick="showLoader()" class="py-2 px-4 font-semibold text-sm border-b-2 border-blue-600 text-blue-600">
        <%= site.subMenus.overview %>
      </a>
      <a href="/cod-portal" onclick="showLoader()" class="py-2 px-4 font-semibold text-sm text-gray-500 hover:text-gray-700">
        <%= site.subMenus.codPortal %>
      </a>
      <a href="/monthly-totals" onclick="showLoader()" class="py-2 px-4 font-semibold text-sm text-gray-500 hover:text-gray-700">
        <%= site.subMenus.monthlyTotals %>
      </a>
      <a href="/entries" onclick="showLoader()" class="py-2 px-4 font-semibold text-sm text-gray-500 hover:text-gray-700">
        <%= site.subMenus.manageEntries %>
      </a>
    </div>

    <!-- Forms Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 no-print">
      
      <!-- Create Account Form -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h2 class="text-lg font-semibold mb-4 text-gray-700">1. Create Payment Account</h2>
        <form action="/accounts/create" method="POST" class="flex gap-3 db-form">
          <input type="text" name="name" placeholder="Account Name (e.g. BILAL Pickles)" required
                 class="flex-1 border border-gray-300 p-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
          <button type="submit" class="bg-slate-800 text-white px-4 py-2 rounded text-sm hover:bg-slate-700 transition">Add Account</button>
        </form>
      </div>

      <!-- Create Entry Form with Searchable Dropdown -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h2 class="text-lg font-semibold mb-4 text-gray-700">2. Add Expense Entry</h2>
        <form action="/entries/create" method="POST" class="grid grid-cols-2 gap-3 db-form">
          
          <div class="col-span-2 relative" id="searchableDropdown">
            <input type="hidden" name="account_id" id="selectedAccountId" required>
            
            <button type="button" id="dropdownBtn"
                    class="w-full border border-gray-300 p-2 rounded text-left flex justify-between items-center bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm text-gray-700">
              <span id="selectedAccountLabel">Select Account / Vendor</span>
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <div id="dropdownMenu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-gray-300 rounded shadow-lg z-30 p-2 max-h-60 overflow-y-auto">
              <div class="sticky top-0 bg-white pb-2 border-b mb-2">
                <input type="text" id="vendorSearchInput" placeholder="Search account..."
                       class="w-full border border-gray-300 px-3 py-1.5 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>
              <ul id="vendorList" class="divide-y divide-gray-100 text-sm">
                <% accounts.forEach(acc => { %>
                  <li data-id="<%= acc.id %>" data-name="<%= acc.name %>" 
                      class="vendor-option px-3 py-2 hover:bg-blue-50 cursor-pointer rounded text-gray-700">
                    <%= acc.name %>
                  </li>
                <% }) %>
              </ul>
              <div id="noVendorFound" class="hidden text-xs text-gray-400 p-2 text-center">No matching vendor found</div>
            </div>
          </div>

          <input type="number" step="0.01" name="amount" placeholder="Amount" required class="border border-gray-300 p-2 rounded text-sm">
          <input type="text" name="month" value="<%= defaultMonth %>" required class="border border-gray-300 p-2 rounded text-sm">
          <input type="date" name="date" value="<%= defaultDate %>" required class="border border-gray-300 p-2 rounded text-sm">
          <input type="text" name="notes" placeholder="Reason / Line items" class="border border-gray-300 p-2 rounded text-sm">
          <button type="submit" class="col-span-2 bg-blue-600 text-white py-2 rounded font-semibold text-sm hover:bg-blue-700 transition">Save Entry</button>
        </form>
      </div>

    </div>

    <!-- Summary & Controls Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden printable-area" id="reportTable">
      
      <div class="p-4 border-b border-gray-200 bg-gray-50 flex flex-wrap justify-between items-center gap-4">
        <div>
          <h2 class="font-bold text-gray-700 text-lg">Monthly Expenses Breakdown</h2>
          <span class="text-xs text-gray-500">Showing breakdown for: <strong class="text-blue-700"><%= selectedMonth %></strong></span>
        </div>

        <div class="flex items-center gap-3 no-print">
          <form method="GET" action="/dashboard" class="flex items-center gap-2">
            <label for="monthFilter" class="text-xs font-semibold text-gray-600">Filter Month:</label>
            <select id="monthFilter" name="month" onchange="showLoader(); this.form.submit()" 
                    class="border border-gray-300 rounded px-3 py-1 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="ALL" <%= selectedMonth === 'ALL' ? 'selected' : '' %>>All Months</option>
              <% availableMonths.forEach(m => { %>
                <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>><%= m %></option>
              <% }) %>
            </select>
          </form>

          <button onclick="window.print()" 
                  class="bg-slate-700 text-white text-xs px-3 py-1.5 rounded flex items-center gap-1 hover:bg-slate-800 transition">
            Print
          </button>

          <button onclick="exportToPDF()" 
                  class="bg-emerald-600 text-white text-xs px-3 py-1.5 rounded flex items-center gap-1 hover:bg-emerald-700 transition">
            Download PDF
          </button>
        </div>
      </div>

      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b bg-gray-100 text-sm font-semibold text-gray-600">
            <th class="p-3 border-r">Month</th>
            <th class="p-3 border-r">Combined Formula / Sub-payments</th>
            <th class="p-3 border-r">Total Amount</th>
            <th class="p-3 border-r">Account / Reason</th>
            <th class="p-3 text-right">Grand Total Column</th>
          </tr>
        </thead>
        <tbody class="divide-y text-sm text-gray-700">
          <% if (summaryList.length === 0) { %>
            <tr>
              <td colspan="5" class="p-4 text-center text-gray-500">No expense records found for this period.</td>
            </tr>
          <% } else { %>
            <% summaryList.forEach((row, idx) => { %>
              <tr class="hover:bg-gray-50">
                <td class="p-3 border-r font-medium"><%= row.month %></td>
                <td class="p-3 border-r font-mono text-xs text-blue-600 bg-slate-50">
                  =<%= row.sub_amounts.join('+') %>
                </td>
                <td class="p-3 border-r font-bold text-gray-900"><%= row.total_amount.toLocaleString() %></td>
                <td class="p-3 border-r"><%= row.account_name %> <%= row.notes ? `(${row.notes})` : '' %></td>
                <td class="p-3 text-right font-bold text-green-700">
                  <% if(idx === 0) { %>
                    <%= grandTotal.toLocaleString() %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    function showLoader() {
      const loader = document.getElementById('loadingOverlay');
      loader.classList.remove('hidden');
      loader.classList.add('flex');
    }

    document.querySelectorAll('.db-form').forEach(form => {
      form.addEventListener('submit', function(e) {
        const accountId = document.getElementById('selectedAccountId').value;
        if (!accountId && this.contains(document.getElementById('searchableDropdown'))) {
          e.preventDefault();
          alert('Please select a Payment Account / Vendor');
          return;
        }
        showLoader();
      });
    });

    const dropdownBtn = document.getElementById('dropdownBtn');
    const dropdownMenu = document.getElementById('dropdownMenu');
    const vendorSearchInput = document.getElementById('vendorSearchInput');
    const vendorOptions = document.querySelectorAll('.vendor-option');
    const selectedAccountId = document.getElementById('selectedAccountId');
    const selectedAccountLabel = document.getElementById('selectedAccountLabel');
    const noVendorFound = document.getElementById('noVendorFound');

    dropdownBtn.addEventListener('click', () => {
      dropdownMenu.classList.toggle('hidden');
      if (!dropdownMenu.classList.contains('hidden')) {
        vendorSearchInput.focus();
      }
    });

    vendorSearchInput.addEventListener('input', function() {
      const filter = this.value.toLowerCase().trim();
      let visibleCount = 0;

      vendorOptions.forEach(opt => {
        const text = opt.getAttribute('data-name').toLowerCase();
        if (text.includes(filter)) {
          opt.style.display = 'block';
          visibleCount++;
        } else {
          opt.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        noVendorFound.classList.remove('hidden');
      } else {
        noVendorFound.classList.add('hidden');
      }
    });

    vendorOptions.forEach(opt => {
      opt.addEventListener('click', function() {
        const id = this.getAttribute('data-id');
        const name = this.getAttribute('data-name');
        
        selectedAccountId.value = id;
        selectedAccountLabel.textContent = name;
        selectedAccountLabel.classList.add('font-semibold', 'text-gray-900');
        
        dropdownMenu.classList.add('hidden');
      });
    });

    document.addEventListener('click', function(e) {
      const dropdownContainer = document.getElementById('searchableDropdown');
      if (dropdownContainer && !dropdownContainer.contains(e.target)) {
        dropdownMenu.classList.add('hidden');
      }
    });

    function exportToPDF() {
      const element = document.getElementById('reportTable');
      const monthSelect = document.getElementById('monthFilter').value;
      
      const opt = {
        margin:       0.5,
        filename:     `Expenses_Report_${monthSelect}.pdf`,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2 },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'landscape' }
      };

      html2pdf().set(opt).from(element).save();
    }
  </script>

</body>
</html>