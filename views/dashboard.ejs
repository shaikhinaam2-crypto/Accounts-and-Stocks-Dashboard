<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Personal Dashboard - SF Expenses Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  
  <style>
    @media print {
      aside, .no-print, form {
        display: none !important;
      }
      main {
        padding: 0 !important;
        overflow: visible !important;
      }
      .printable-area {
        border: none !important;
        box-shadow: none !important;
      }
    }
  </style>
</head>
<body class="bg-gray-100 font-sans flex h-screen">

  <!-- Main Left Sidebar Navigation -->
  <aside class="w-64 bg-slate-900 text-white flex flex-col justify-between no-print">
    <div>
      <div class="p-6 text-xl font-bold border-b border-slate-800">My Dashboard</div>
      <nav class="mt-4">
        <div class="px-6 py-2 text-xs text-slate-400 uppercase tracking-wider">Portals</div>
        <a href="/dashboard" class="flex items-center px-6 py-3 bg-blue-600 text-white font-medium">
          SF Expenses Portal
        </a>
        <a href="#" class="flex items-center px-6 py-3 text-slate-300 hover:bg-slate-800">
          Menu Two (Portal 2)
        </a>
        <a href="#" class="flex items-center px-6 py-3 text-slate-300 hover:bg-slate-800">
          Menu Three (Portal 3)
        </a>
      </nav>
    </div>
    <div class="p-4 border-t border-slate-800">
      <a href="/settings" class="block py-2 text-sm text-slate-300 hover:text-white">Settings</a>
      <a href="/logout" class="block py-2 text-sm text-red-400 hover:text-red-300">Logout</a>
    </div>
  </aside>

  <!-- Main View Area -->
  <main class="flex-1 overflow-y-auto p-8">
    <div class="flex justify-between items-center mb-4 no-print">
      <h1 class="text-2xl font-bold text-gray-800">SF Expenses Portal</h1>
      <div class="text-sm bg-blue-50 text-blue-800 border border-blue-200 px-4 py-2 rounded-lg font-semibold">
        Grand Total: <%= grandTotal.toLocaleString() %> PKR
      </div>
    </div>

    <!-- Sub-page Tab Navigation -->
    <div class="flex border-b border-gray-200 mb-6 no-print">
      <a href="/dashboard" class="py-2 px-4 font-semibold text-sm border-b-2 border-blue-600 text-blue-600">
        Overview & Summary
      </a>
      <a href="/entries" class="py-2 px-4 font-semibold text-sm text-gray-500 hover:text-gray-700">
        Manage All Entries (Edit / Delete)
      </a>
    </div>

    <!-- Forms Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 no-print">
      
      <!-- Create Account Form -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h2 class="text-lg font-semibold mb-4 text-gray-700">1. Create Payment Account</h2>
        <form action="/accounts/create" method="POST" class="flex gap-3">
          <input type="text" name="name" placeholder="Account Name (e.g. BILAL Pickles)" required
                 class="flex-1 border border-gray-300 p-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
          <button type="submit" class="bg-slate-800 text-white px-4 py-2 rounded hover:bg-slate-700">Add Account</button>
        </form>
      </div>

      <!-- Create Entry Form -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h2 class="text-lg font-semibold mb-4 text-gray-700">2. Add Expense Entry</h2>
        <form action="/entries/create" method="POST" class="grid grid-cols-2 gap-3">
          <div class="col-span-2">
            <select name="account_id" required class="w-full border border-gray-300 p-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">Select Account / Vendor</option>
              <% accounts.forEach(acc => { %>
                <option value="<%= acc.id %>"><%= acc.name %></option>
              <% }) %>
            </select>
          </div>
          <input type="number" step="0.01" name="amount" placeholder="Amount" required class="border border-gray-300 p-2 rounded">
          <input type="text" name="month" value="<%= defaultMonth %>" required class="border border-gray-300 p-2 rounded">
          <input type="date" name="date" value="<%= defaultDate %>" required class="border border-gray-300 p-2 rounded">
          <input type="text" name="notes" placeholder="Reason / Line items" class="border border-gray-300 p-2 rounded">
          <button type="submit" class="col-span-2 bg-blue-600 text-white py-2 rounded font-semibold hover:bg-blue-700">Save Entry</button>
        </form>
      </div>

    </div>

    <!-- Summary & Controls Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden printable-area" id="reportTable">
      
      <div class="p-4 border-b border-gray-200 bg-gray-50 flex flex-wrap justify-between items-center gap-4">
        <div>
          <h2 class="font-bold text-gray-700 text-lg">Monthly Expenses Breakdown</h2>
          <span class="text-xs text-gray-500">Showing breakdown for: <strong class="text-blue-700"><%= selectedMonth %></strong></span>
        </div>

        <div class="flex items-center gap-3 no-print">
          <form method="GET" action="/dashboard" class="flex items-center gap-2">
            <label for="monthFilter" class="text-xs font-semibold text-gray-600">Filter Month:</label>
            <select id="monthFilter" name="month" onchange="this.form.submit()" 
                    class="border border-gray-300 rounded px-3 py-1 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="ALL" <%= selectedMonth === 'ALL' ? 'selected' : '' %>>All Months</option>
              <% availableMonths.forEach(m => { %>
                <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>><%= m %></option>
              <% }) %>
            </select>
          </form>

          <button onclick="window.print()" 
                  class="bg-slate-700 text-white text-xs px-3 py-1.5 rounded flex items-center gap-1 hover:bg-slate-800">
            Print
          </button>

          <button onclick="exportToPDF()" 
                  class="bg-emerald-600 text-white text-xs px-3 py-1.5 rounded flex items-center gap-1 hover:bg-emerald-700">
            Download PDF
          </button>
        </div>
      </div>

      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b bg-gray-100 text-sm font-semibold text-gray-600">
            <th class="p-3 border-r">Month</th>
            <th class="p-3 border-r">Combined Formula / Sub-payments</th>
            <th class="p-3 border-r">Total Amount</th>
            <th class="p-3 border-r">Account / Reason</th>
            <th class="p-3 text-right">Grand Total Column</th>
          </tr>
        </thead>
        <tbody class="divide-y text-sm text-gray-700">
          <% if (summaryList.length === 0) { %>
            <tr>
              <td colspan="5" class="p-4 text-center text-gray-500">No expense records found for this period.</td>
            </tr>
          <% } else { %>
            <% summaryList.forEach((row, idx) => { %>
              <tr class="hover:bg-gray-50">
                <td class="p-3 border-r font-medium"><%= row.month %></td>
                <td class="p-3 border-r font-mono text-xs text-blue-600 bg-slate-50">
                  =<%= row.sub_amounts.join('+') %>
                </td>
                <td class="p-3 border-r font-bold text-gray-900"><%= row.total_amount.toLocaleString() %></td>
                <td class="p-3 border-r"><%= row.account_name %> <%= row.notes ? `(${row.notes})` : '' %></td>
                <td class="p-3 text-right font-bold text-green-700">
                  <% if(idx === 0) { %>
                    <%= grandTotal.toLocaleString() %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    function exportToPDF() {
      const element = document.getElementById('reportTable');
      const monthSelect = document.getElementById('monthFilter').value;
      
      const opt = {
        margin:       0.5,
        filename:     `SF_Expenses_Report_${monthSelect}.pdf`,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2 },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'landscape' }
      };

      html2pdf().set(opt).from(element).save();
    }
  </script>

</body>
</html>